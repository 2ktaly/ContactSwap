    "Vor jedem Leeren legt die App ein vollständiges Backup an. Unter „Zurück“ spielst du es jederzeit wieder ein.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Leeren legt die App ein vollständiges Backup an. Unter „Zurück“ spielst du es jederzeit wieder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app creates a full backup before every clear-out. You can restore it at any time under “Restore”."
          }
        }
      }
    },
