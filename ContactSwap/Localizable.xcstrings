    "Wird leicht übersehen: Einmal eingerichtet, läuft der Abgleich unauffällig weiter. Dazu zählen eigene Server wie Nextcloud und CardDAV bei Mail-Anbietern.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird leicht übersehen: Einmal eingerichtet, läuft der Abgleich unauffällig weiter. Dazu zählen eigene Server wie Nextcloud und CardDAV bei Mail-Anbietern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy to miss: once set up, the sync keeps running quietly. This includes your own servers such as Nextcloud and CardDAV at mail providers."
          }
        }
      }
    },
    "Wo die Daten liegen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo die Daten liegen"
          }
        },
        "en": {
