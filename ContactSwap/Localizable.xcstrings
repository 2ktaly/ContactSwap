    "Ohne Freigabe kann die App dein Adressbuch weder sichern noch zurückschreiben. Im nächsten Schritt fragt iOS danach.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Freigabe kann die App dein Adressbuch weder sichern noch zurückschreiben. Im nächsten Schritt fragt iOS danach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without access the app can neither back up your address book nor write it back. iOS will ask in the next step."
          }
        }
      }
    },
    "Ohne Kontaktfreigabe kann die App weder sichern noch wiederherstellen. Der Knopf führt direkt zur richtigen Stelle in den Systemeinstellungen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Kontaktfreigabe kann die App weder sichern noch wiederherstellen. Der Knopf führt direkt zur richtigen Stelle in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without contact access the app can neither back up nor restore. This button takes you straight to the right place in System Settings."
          }
        }
      }
    },
    "Orange markierte Quellen hängen an einem Server. Löschungen wirken dort und auf allen verbundenen Geräten. Manche Dienste spielen Kontakte auch wieder zurück.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orange markierte Quellen hängen an einem Server. Löschungen wirken dort und auf allen verbundenen Geräten. Manche Dienste spielen Kontakte auch wieder zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources marked orange are tied to a server. Deletions take effect there and on every connected device. Some services also put the contacts back."
          }
        }
      }
    },
