            "state": "translated",
            "value": "Where the data is kept"
          }
        }
      }
    },
    "Wähle die Kontakte aus, die im Adressbuch bleiben sollen. Alle anderen werden entfernt. Vorher legt die App ein vollständiges Backup an.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Kontakte aus, die im Adressbuch bleiben sollen. Alle anderen werden entfernt. Vorher legt die App ein vollständiges Backup an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the contacts that should stay in the address book. All others are removed. The app creates a full backup first."
          }
        }
      }
    },
