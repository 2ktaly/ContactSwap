    "Das Adressbuch wird geleert und exakt auf den Stand des Backups gebracht. Empfohlen nach einem Swap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Adressbuch wird geleert und exakt auf den Stand des Backups gebracht. Empfohlen nach einem Swap."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address book is cleared and restored exactly to the state of the backup. Recommended after a swap."
          }
        }
      }
    },
    "Das Backup liegt jetzt doppelt vor.": {
      "extractionState": "manual",
      "localizations": {
