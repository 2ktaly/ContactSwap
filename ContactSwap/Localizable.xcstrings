    "Alle Kontakt-Syncs abschalten. Zuerst iCloud, das ist fast immer aktiv.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kontakt-Syncs abschalten. Zuerst iCloud, das ist fast immer aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off every contact sync. Start with iCloud, it is almost always on."
          }
        }
      }
    },
    "Alle Kontakte (%lld)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kontakte (%lld)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All contacts (%lld)"
          }
        }
