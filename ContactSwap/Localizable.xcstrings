{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %lld Kontakte": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld Kontakte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld contacts"
          }
        }
      }
    },
    "%@. Löschungen wirken dort und auf allen verbundenen Geräten. Unter „Einstellungen“ nachsehen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Löschungen wirken dort und auf allen verbundenen Geräten. Unter „Einstellungen“ nachsehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Deletions take effect there and on every connected device. See “Settings” for details."
          }
        }
      }
    },
    "%lld Kontakte entfernt, %lld behalten.\n\nGesichert als „%@“. Über „Zurück“ kommt alles wieder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Kontakte entfernt, %lld behalten.\n\nGesichert als „%@“. Über „Zurück“ kommt alles wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contacts removed, %lld kept.\n\nSaved as “%@”. Everything comes back under “Restore”."
          }
        }
      }
    },
    "%lld Kontakte und %lld Fotos werden zurückgeschrieben.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Kontakte und %lld Fotos werden zurückgeschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld contacts and %lld photos will be written back."
          }
        }
      }
    },
