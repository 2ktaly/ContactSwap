            "value": "Swaps left"
          }
        }
      }
    },
    "Synchronisiert in beide Richtungen und stellt gelöschte Kontakte oft binnen Minuten vom Server wieder her. Der klassische Fall, in dem eine Recherche unbrauchbar wird.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert in beide Richtungen und stellt gelöschte Kontakte oft binnen Minuten vom Server wieder her. Der klassische Fall, in dem eine Recherche unbrauchbar wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs both ways and often restores deleted contacts from the server within minutes. The classic way to ruin the whole exercise."
          }
        }
      }
    },
    "Uhr": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uhr"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock"
          }
        }
      }
    },
    "Unbegrenzte Swaps, dauerhaft. Der Kauf gilt für alle Geräte mit derselben Apple-ID.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Swaps, dauerhaft. Der Kauf gilt für alle Geräte mit derselben Apple-ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited swaps, permanently. The purchase covers every device using the same Apple Account."
          }
        }
      }
    },
    "Unter dieser Apple-ID liegt kein Kauf vor.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Apple-ID liegt kein Kauf vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no purchase under this Apple Account."
          }
        }
      }
    },
    "Unter „Einstellungen → Apps → Kontakte → Kontakte-Accounts“ stehen sämtliche Quellen untereinander. Jeder Eintrag mit aktivem Schalter „Kontakte“ ist eine davon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Einstellungen → Apps → Kontakte → Kontakte-Accounts“ stehen sämtliche Quellen untereinander. Jeder Eintrag mit aktivem Schalter „Kontakte“ ist eine davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Settings → Apps → Contacts → Contacts Accounts” lists every source in one place. Each entry with “Contacts” switched on is one of them."
          }
        }
      }
    },
    "Unter „Swap“ die Kontakte auswählen, die bleiben sollen, und auf „Leeren“ tippen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Swap“ die Kontakte auswählen, die bleiben sollen, und auf „Leeren“ tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under “Swap”, select the contacts to keep and tap “Clear”."
          }
        }
      }
    },
    "Unter „Zurück“ das Backup wieder einspielen, dann die Syncs wieder einschalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter „Zurück“ das Backup wieder einspielen, dann die Syncs wieder einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the backup under “Restore”, then turn the syncs back on."
          }
        }
      }
    },
