    "Behörden und Institutionen beziehen Lizenzen im Bündel über Apple Business Manager. Auf der Website stehen der Ablauf und die Ansprechpartner.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behörden und Institutionen beziehen Lizenzen im Bündel über Apple Business Manager. Auf der Website stehen der Ablauf und die Ansprechpartner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public bodies and institutions obtain licences in bulk through Apple Business Manager. The website explains the process and lists the contacts."
          }
        }
      }
    },
    "Beide brauchen keine Beachtung. LDAP durchsucht nur ein Verzeichnis, ohne etwas ins Adressbuch zu schreiben. SIM-Kontakte werden einmalig importiert und synchronisieren nicht.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide brauchen keine Beachtung. LDAP durchsucht nur ein Verzeichnis, ohne etwas ins Adressbuch zu schreiben. SIM-Kontakte werden einmalig importiert und synchronisieren nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither needs attention. LDAP only searches a directory without writing to the address book. SIM contacts are imported once and do not sync."
          }
        }
      }
    },
    "Bekannte Einschränkung": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
