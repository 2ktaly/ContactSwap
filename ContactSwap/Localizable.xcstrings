            "value": "The backup now exists twice."
          }
        }
      }
    },
    "Das Icon lässt sich hier wechseln. Den Namen darunter kann iOS nicht zur Laufzeit ändern. Dafür gibt es den Weg über einen Kurzbefehl.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Icon lässt sich hier wechseln. Den Namen darunter kann iOS nicht zur Laufzeit ändern. Dafür gibt es den Weg über einen Kurzbefehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change the icon here. iOS cannot change the name below it at runtime. Use a Shortcut for that instead."
          }
        }
      }
    },
