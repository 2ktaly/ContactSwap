    "Alle Kontakte liegen lokal auf diesem iPhone. Ein Swap wirkt nirgendwo sonst.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kontakte liegen lokal auf diesem iPhone. Ein Swap wirkt nirgendwo sonst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All contacts are stored locally on this iPhone. A swap has no effect anywhere else."
          }
        }
      }
    },
    "Alle Kontakte werden lokal verarbeitet und verschlüsselt auf dem iPhone gesichert. Die App sendet nichts ins Netz und hat kein Benutzerkonto.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kontakte werden lokal verarbeitet und verschlüsselt auf dem iPhone gesichert. Die App sendet nichts ins Netz und hat kein Benutzerkonto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All contacts are processed locally and stored encrypted on the iPhone. The app sends nothing over the network and has no user account."
          }
        }
      }
    },
    "Alle auf einen Blick": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle auf einen Blick"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All at a glance"
          }
        }
      }
    },
    "Alles, was hier aktiv ist, überlebt einen Swap oder macht ihn rückgängig. Welche Quellen auf diesem iPhone laufen, steht unter „Einstellungen“ in der App.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was hier aktiv ist, überlebt einen Swap oder macht ihn rückgängig. Welche Quellen auf diesem iPhone laufen, steht unter „Einstellungen“ in der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything active here survives a swap or undoes it. The sources running on this iPhone are listed under “Settings” in the app."
          }
        }
      }
    },
    "App selbst verbergen": {
      "extractionState": "manual",
      "localizations": {
