    "Sobald du unter „Swap“ das Adressbuch leerst, legt die App ein Backup an. Es erscheint dann hier.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du unter „Swap“ das Adressbuch leerst, legt die App ein Backup an. Es erscheint dann hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As soon as you clear the address book under “Swap”, the app creates a backup. It will appear here."
          }
        }
      }
    },
    "Speicherung": {
      "extractionState": "manual",
      "localizations": {
